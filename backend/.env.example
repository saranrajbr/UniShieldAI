# UniShield AI — Backend Environment Configuration

# Application
APP_NAME=UniShield AI
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./unishield.db
DB_ECHO=false

# Detection thresholds
DETECTION_THRESHOLD=0.6
HIGH_RISK_THRESHOLD=0.85
CRITICAL_RISK_THRESHOLD=0.95

# Rule / ML fusion weights
RULE_WEIGHT_SIGNATURE=0.30
RULE_WEIGHT_STATISTICAL=0.25
RULE_WEIGHT_BEHAVIORAL=0.25
ML_WEIGHT_SUPERVISED=0.12
ML_WEIGHT_ANOMALY=0.08

# Model artifacts
ML_MODEL_DIR=models
XGBOOST_MODEL_PATH=models/xgboost/model.json
ISOLATION_FOREST_MODEL_PATH=models/isolation_forest/model.pkl
SCALER_PATH=models/preprocessing/scaler.pkl
FEATURE_COLUMNS_PATH=models/preprocessing/feature_columns.json

# PCAP recording
PCAP_ACTIVE_PATH=captures/active/current.pcap
PCAP_INCIDENTS_PATH=captures/incidents
PCAP_ARCHIVE_PATH=captures/archive
PCAP_MAX_BYTES=104857600
PCAP_ROTATION_INTERVAL_SEC=300

# State
FLOW_TIMEOUT_SEC=120
CONNECTION_EXPIRY_SEC=300
ROLLING_WINDOW_SEC=60
DEDUP_WINDOW_SEC=300

# Pipeline
MAX_CONCURRENT_FLOWS=10000
PIPELINE_QUEUE_SIZE=50000

# Flow-export listener (NetFlow v5/v9, IPFIX v10, sFlow)
NETFLOW_UDP_HOST=0.0.0.0
NETFLOW_UDP_PORT=2055

# Sensor
SENSOR_ENDPOINT=http://localhost:8000/api/v1/traffic/flow

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173